+        if (msg is! Map) continue;
+        final body = (msg['body'] as String? ?? '').trim();
+        if (body.isEmpty) continue;
+        final timestamp = msg['date'];
+        final sent = msg['dateSent'];
+        rows.add((
+          body: body,
+          sender: msg['sender'] as String? ?? '',
+          date: DateTime.fromMillisecondsSinceEpoch(
+            timestamp is int ? timestamp : 0,
+          ),
+          sentAt:
+              sent is int && sent > 0
+                  ? DateTime.fromMillisecondsSinceEpoch(sent)
+                  : null,
+        ));
+      }
+      return rows;
+    } catch (_) {
+      return const [];
+    }
+  }
