    "test:net-worth": "npx tsx scripts/test-net-worth.ts",
    "test:financial-invalidation": "npx tsx scripts/test-financial-invalidation.ts",
    "test:transaction-accounting": "npx tsx scripts/test-transaction-accounting.ts",
