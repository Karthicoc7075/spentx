    "test:duplicate-transactions": "npx tsx scripts/test-duplicate-transactions.ts",
    "test:outing-purpose": "npx tsx scripts/test-outing-purpose-cascade.ts",
    "test:shared-multi-split": "npx tsx scripts/test-shared-multi-split.ts",
    "test:plan-analysis-splits": "npx tsx scripts/test-plan-analysis-splits.ts",
    "test:mobile-sms": "cd \"Mobile app/SpentX\" && dart run test/sms_notification_copy_test.dart",
    "test:mobile-auth-routing": "cd \"Mobile app/SpentX\" && dart run test/auth_verification_routing_test.dart",
    "test:sms": "cd \"Mobile app/SpentX\" && flutter test && dart run tool/check_parser.dart",
    "test:mobile-bank-allowlist": "cd \"Mobile app/SpentX\" && dart run test/bank_allowlist_test.dart",
    "test:mobile-pending-account": "cd \"Mobile app/SpentX\" && dart run test/pending_account_test.dart",
    "test:mobile-plan-alerts": "cd \"Mobile app/SpentX\" && dart run test/plan_alerts_test.dart",
    "test:all": "npm run test:net-worth && npm run test:financial-invalidation && npm run test:transaction-accounting && npm run test:duplicate-transactions && npm run test:mobile-sms && npm run test:mobile-auth-routing && npm run test:mobile-bank-allowlist && npm run test:mobile-pending-account && npm run test:mobile-plan-alerts",
    "seed:sms-templates": "npx tsx scripts/seed-bank-sms-templates.ts",
    "seed:sms-block-rules": "npx tsx scripts/seed-sms-block-rules.ts"
  },
